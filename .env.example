# ---- Feishu / Lark ----
LARK_OPENAPI_HOST=https://open.feishu.cn
#
# IMPORTANT: VC / meeting Bot OpenAPIs (bots/join, realtime/endpoint)
# REQUIRE a user_access_token. App / tenant tokens are rejected with
# error code 99991663 ("Invalid access token"). For production use,
# provide FEISHU_REFRESH_TOKEN and app credentials so this assistant can
# rotate FEISHU_USER_ACCESS_TOKEN automatically.
FEISHU_USER_ACCESS_TOKEN=
FEISHU_REFRESH_TOKEN=
FEISHU_USER_ACCESS_TOKEN_EXPIRES_AT=0
#
# Fallbacks (only useful for OpenAPIs that DO accept tenant token,
# e.g. messaging APIs). App credentials are also required when using
# FEISHU_REFRESH_TOKEN for user token refresh.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: pre-issued tenant access token (overrides app_id/secret if set)
# FEISHU_TENANT_ACCESS_TOKEN=

# ---- Volcengine Streaming ASR (big model) ----
VOLC_ASR_BACKEND=sdk
VOLC_ASR_APPID=
VOLC_ASR_TOKEN=
VOLC_ASR_CLUSTER=volcengine_streaming_common
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_LANGUAGE=zh-CN
VOLC_ASR_CONNECT_TIMEOUT_S=10
VOLC_ASR_STREAM_IDLE_TIMEOUT_S=20

# ---- OpenAI-compatible LLM ----
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=ep-xxxxxxxx
# For realtime voice, prefer a flash-class endpoint first; use lite only if
# latency is the top priority and summary/evaluation quality remains acceptable.
LLM_SYSTEM_PROMPT=You are James, a real-time meeting voice assistant. Reply in the user's language. Start with a direct one-sentence answer, then add at most 3 concise bullets if useful. Ground answers in Meeting Memory; if the memory does not support an answer, say so briefly. For summaries or evaluations, use: overview, highlights, issues, suggestions. Keep most voice replies under 80 words unless the user asks for detail.
LLM_MAX_HISTORY_TURNS=8
MEETING_CONTEXT_MAX_CHARS=6000
LLM_MAX_TOKENS=220
LLM_REQUEST_TIMEOUT_S=20
LLM_STREAM_IDLE_TIMEOUT_S=12
LLM_TTS_CHUNK_MIN_CHARS=6
LLM_TTS_CHUNK_MAX_CHARS=80

# ---- Volcengine Streaming TTS (big model) ----
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_API_VERSION=2.0
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
VOLC_TTS_HTTP_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=zh_male_shaonianzixin_uranus_bigtts
VOLC_TTS_CONNECT_TIMEOUT_S=10
VOLC_TTS_STREAM_IDLE_TIMEOUT_S=10

# ---- Agent tuning ----
WAKE_WORDS=hey james,james,嘿james,嘿 james
STOP_WORDS=stop,shut up,be quiet,enough,别说了,闭嘴,安静,住口,算了,停
END_SESSION_WORDS=stop,thanks james,thank you james,结束,先这样,不用了,别说了
ENGAGED_IDLE_TIMEOUT_S=0
MEMORY_RECENT_UTTERANCES=50
MEMORY_SUMMARY_ITEMS=8
MEMORY_CONTEXT_RECENT_UTTERANCES=16
MEMORY_ROLLUP_UTTERANCES=10
MEMORY_ROLLUP_MAX_CHARS=1800
MEMORY_ROLLUP_SOURCE_MAX_CHARS=5000
MEMORY_RETRIEVAL_MAX_ITEMS=6
REPLY_ERROR_TTS_TEXT=抱歉，我刚才没组织好回答，请再说一遍。
WAKE_ACK_TTS_TEXT_ZH=我在，请讲。
WAKE_ACK_TTS_TEXT_EN=I'm here. Go ahead.
AGENT_RECONNECT_ATTEMPTS=3
AGENT_RECONNECT_BACKOFF_S=2.0
LOG_LEVEL=INFO
