# ---- Feishu / Lark ----
LARK_OPENAPI_HOST=https://open.feishu.cn
#
# IMPORTANT: VC / meeting Bot OpenAPIs (bots/join, realtime/endpoint)
# REQUIRE a user_access_token. App / tenant tokens are rejected with
# error code 99991663 ("Invalid access token"). For production use,
# provide FEISHU_REFRESH_TOKEN and app credentials so this assistant can
# rotate FEISHU_USER_ACCESS_TOKEN automatically.
FEISHU_USER_ACCESS_TOKEN=
FEISHU_REFRESH_TOKEN=
FEISHU_USER_ACCESS_TOKEN_EXPIRES_AT=0
#
# Fallbacks (only useful for OpenAPIs that DO accept tenant token,
# e.g. messaging APIs). App credentials are also required when using
# FEISHU_REFRESH_TOKEN for user token refresh.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: pre-issued tenant access token (overrides app_id/secret if set)
# FEISHU_TENANT_ACCESS_TOKEN=

# ---- Volcengine Streaming ASR (big model) ----
# Backend choices:
# - legacy: handcrafted WS client, currently preferred for the English-first live demo
# - sdk: official SDK path, useful for experimentation and future migration work
VOLC_ASR_BACKEND=legacy
VOLC_ASR_APPID=
VOLC_ASR_TOKEN=
VOLC_ASR_CLUSTER=volcengine_streaming_common
# Usually keep this as volc.bigasr.sauc.duration unless your account requires another resource.
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
# Preferred stable live-demo endpoint. If you use sdk/v3 instead, update both backend and URL together.
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v2/asr
# English-first meetings are the current primary demo path.
VOLC_ASR_LANGUAGE=en-US
# Timeout for establishing the ASR connection.
VOLC_ASR_CONNECT_TIMEOUT_S=10
# Max silence / no-frame wait before ASR stream is considered stalled.
VOLC_ASR_STREAM_IDLE_TIMEOUT_S=20

# ---- OpenAI-compatible LLM ----
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
# Current low-latency demo choice.
LLM_MODEL=doubao-seed-2-0-mini-260428
# English-first spoken style. Keep this as a single line because .env parsers do not support multiline values well.
LLM_SYSTEM_PROMPT=You are James, a real-time meeting voice assistant for English-first meetings. Reply in natural spoken English by default. Only reply in Chinese when the current user utterance clearly contains Chinese characters and is primarily Chinese. Do not switch to Chinese because of Chinese punctuation, mixed punctuation, prior history, or meeting memory language. Sound like a polished live assistant: one smooth short spoken paragraph, not bullets, unless the user explicitly asks for a list. Start with a direct answer, then add one brief supporting sentence if useful. Ground answers in Meeting Memory; if the memory does not support an answer, say so briefly. For summaries or evaluations, keep the response concise, structured, and easy to speak aloud.
# Number of user/assistant turns retained in short-term chat history.
LLM_MAX_HISTORY_TURNS=8
# Max chars of meeting memory injected into the answer prompt.
MEETING_CONTEXT_MAX_CHARS=2500
# Reply length cap. Lower values reduce latency and rambling.
LLM_MAX_TOKENS=100
# Whole-request timeout when talking to the LLM provider.
LLM_REQUEST_TIMEOUT_S=20
# Idle timeout while waiting for the next streamed token.
LLM_STREAM_IDLE_TIMEOUT_S=12
# TTS chunking: larger chunks sound more natural, smaller chunks start faster.
LLM_TTS_CHUNK_MIN_CHARS=12
LLM_TTS_CHUNK_MAX_CHARS=100

# ---- Volcengine Streaming TTS (big model) ----
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
# Keep 2.0 for the preferred HTTP V3 streaming path. Set 1.0 only if you want the legacy WS path.
VOLC_TTS_API_VERSION=2.0
VOLC_TTS_CLUSTER=volcano_tts
# Used only by the legacy WebSocket TTS path.
VOLC_TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
# Used by the preferred TTS 2.0 unidirectional HTTP streaming path.
VOLC_TTS_HTTP_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# Current preferred bilingual demo voice. Good English delivery, slightly expressive.
VOLC_TTS_VOICE_TYPE=zh_male_m191_uranus_bigtts
# Timeout for establishing the TTS connection / HTTP stream.
VOLC_TTS_CONNECT_TIMEOUT_S=10
# Max wait for the next audio chunk before treating the TTS stream as stalled.
VOLC_TTS_STREAM_IDLE_TIMEOUT_S=10

# ---- Agent tuning ----
# Comma-separated wake phrases. Wake words move the bot from WAITING to ENGAGED.
WAKE_WORDS=hey james,james,嘿james,嘿 james
# Stop the current reply but keep the session engaged.
STOP_WORDS=stop,shut up,be quiet,enough,别说了,闭嘴,安静,住口,算了,停
# End the current session and return the bot to WAITING.
END_SESSION_WORDS=stop,thanks james,thank you james,结束,先这样,不用了,别说了
# IMPORTANT: keep this key defined only once. `0` disables auto-return to WAITING.
ENGAGED_IDLE_TIMEOUT_S=0
# Number of recent utterances kept in short-term memory.
MEMORY_RECENT_UTTERANCES=50
# Max extracted decisions / actions / risks / questions kept in structured summary buckets.
MEMORY_SUMMARY_ITEMS=8
# Number of recent utterances injected as direct context to the LLM.
MEMORY_CONTEXT_RECENT_UTTERANCES=16
# Trigger a rolling-summary refresh after this many new utterances.
MEMORY_ROLLUP_UTTERANCES=10
# Cap for the compressed rolling summary stored in memory.
MEMORY_ROLLUP_MAX_CHARS=1800
# Cap for raw transcript text passed into a rollup update request.
MEMORY_ROLLUP_SOURCE_MAX_CHARS=5000
# How many relevant memory items to retrieve for answering a query.
MEMORY_RETRIEVAL_MAX_ITEMS=6
# Spoken fallback when reply generation fails.
REPLY_ERROR_TTS_TEXT=抱歉，我刚才没组织好回答，请再说一遍。
# Fixed short acknowledgment when the user only says the wake word.
WAKE_ACK_TTS_TEXT_ZH=我在，请讲。
WAKE_ACK_TTS_TEXT_EN=I'm here. Go ahead.
# Realtime reconnect policy after recoverable failures.
AGENT_RECONNECT_ATTEMPTS=3
AGENT_RECONNECT_BACKOFF_S=2.0
# Use INFO for normal demos. Raise to DEBUG only when actively diagnosing.
LOG_LEVEL=INFO
